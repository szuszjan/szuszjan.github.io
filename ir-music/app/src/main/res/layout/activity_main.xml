<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/status"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="13sp"
            android:paddingBottom="8dp" />

        <!-- ===== Nadajnik ===== -->
        <TextView style="@style/Header" android:text="Nadajnik" />
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowLabel" android:text="Nośna [Hz]" />
            <EditText android:id="@+id/carrier" style="@style/RowEdit" android:text="38000" />
        </LinearLayout>

        <!-- ===== Melodia ===== -->
        <TextView style="@style/Header" android:text="Melodia" />
        <Spinner
            android:id="@+id/songs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <EditText
            android:id="@+id/notes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minLines="3"
            android:maxLines="12"
            android:scrollbars="vertical"
            android:gravity="top"
            android:inputType="textMultiLine|textNoSuggestions"
            android:fontFamily="monospace"
            android:textSize="12sp" />
        <LinearLayout style="@style/Row">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tempo BPM " />
            <EditText
                android:id="@+id/bpm"
                android:layout_width="80dp"
                android:layout_height="wrap_content"
                android:inputType="number"
                android:text="120" />
            <CheckBox
                android:id="@+id/loop"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Zapętl" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <Button android:id="@+id/play" style="@style/WideButton" android:text="▶ Graj" />
            <Button android:id="@+id/stop" style="@style/WideButton" android:text="■ Stop" />
        </LinearLayout>
        <TextView
            android:id="@+id/nowPlaying"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="monospace"
            android:paddingTop="4dp" />

        <!-- ===== Barwa ===== -->
        <TextView style="@style/Header" android:text="Barwa dźwięku" />
        <Spinner
            android:id="@+id/preset"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:id="@+id/timbreBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ===== Polifonia ===== -->
        <TextView style="@style/Header" android:text="Polifonia (akordy i głosy)" />
        <Spinner
            android:id="@+id/polyMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout
            android:id="@+id/polyBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- ===== Klawiatura ===== -->
        <TextView style="@style/Header" android:text="Klawiatura (przytrzymaj)" />
        <LinearLayout
            android:id="@+id/keysSharp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout
            android:id="@+id/keysWhite"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />
        <LinearLayout style="@style/Row">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Oktawa " />
            <Button
                android:id="@+id/octDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="−" />
            <TextView
                android:id="@+id/octLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingLeft="12dp"
                android:paddingRight="12dp"
                android:textSize="18sp"
                android:text="4" />
            <Button
                android:id="@+id/octUp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+" />
        </LinearLayout>

        <TextView style="@style/Header" android:text="Perkusja (stuknij)" />
        <LinearLayout
            android:id="@+id/drumPads"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal" />

        <!-- ===== Ton testowy ===== -->
        <TextView style="@style/Header" android:text="Ton testowy (czysty, 50 %)" />
        <TextView
            android:id="@+id/toneLabel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <SeekBar
            android:id="@+id/tone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progress="500" />
        <LinearLayout style="@style/Row">
            <Button android:id="@+id/toneBtn" style="@style/WideButton" android:text="Ton ciągły" />
            <Button android:id="@+id/sweepBtn" style="@style/WideButton" android:text="Sweep" />
        </LinearLayout>

        <!-- ===== Wzorce testowe ===== -->
        <TextView style="@style/Header" android:text="Wzorce testowe" />
        <Spinner
            android:id="@+id/pattern"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />
        <LinearLayout style="@style/Row">
            <TextView android:id="@+id/patALabel" style="@style/RowLabel" android:text="A" />
            <EditText android:id="@+id/patA" style="@style/RowEdit" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <TextView android:id="@+id/patBLabel" style="@style/RowLabel" android:text="B" />
            <EditText android:id="@+id/patB" style="@style/RowEdit" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <Button android:id="@+id/patStart" style="@style/WideButton" android:text="▶ Start" />
            <Button android:id="@+id/patStop" style="@style/WideButton" android:text="■ Stop" />
        </LinearLayout>

        <!-- ===== Zaawansowane ===== -->
        <TextView style="@style/Header" android:text="Zaawansowane" />
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowLabel" android:text="Maks. długość jednej transmisji [ms]" />
            <EditText android:id="@+id/maxChunk" style="@style/RowEdit" android:text="400" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowLabel" android:text="Maks. liczba wpisów wzorca" />
            <EditText android:id="@+id/maxEntries" style="@style/RowEdit" android:text="1000" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowLabel" android:text="Przerwa między nutami [ms]" />
            <EditText android:id="@+id/gap" style="@style/RowEdit" android:text="25" />
        </LinearLayout>
        <LinearLayout style="@style/Row">
            <TextView style="@style/RowLabel" android:text="Min. impuls / przerwa [µs]" />
            <EditText android:id="@+id/minPulse" style="@style/RowEdit" android:text="30" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingTop="12dp"
            android:textSize="12sp"
            android:text="@string/help" />
    </LinearLayout>
</ScrollView>
